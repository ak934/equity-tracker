generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Stock {
  id     String @id @default(cuid())
  ticker String @unique
  name   String
  status String // "Watchlist" | "Portfolio"
  lastPrice Float?
  priceAsOf DateTime?
  targetPrice Float?
  hiddenFromDashboard Boolean @default(false)
  needsReanalysis Boolean @default(false)
  reanalysisReason String? // "manual" | "stale"
  analysisRunning Boolean @default(false)
  createdAt DateTime @default(now())
}

model Analysis {
  id             String @id @default(cuid())
  ticker         String
  date           DateTime @default(now())
  qualityScore   Int
  valuationScore Int
  action         String
  fullText       String 

  @@index([ticker])
}