generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Stock {
  id                  String      @id @default(cuid())
  clerkUserId         String
  ticker              String
  name                String
  // The specific company's SEC filer id, from the price API's ticker search —
  // the same ticker string can be reused by unrelated companies (different
  // exchanges, or a delisted ticker reassigned later), so this is what
  // analysis is anchored to, not the bare ticker. Null for stocks added
  // before this existed.
  cik                 String?
  status              String
  lastPrice           Float?
  createdAt           DateTime    @default(now())
  priceAsOf           DateTime?
  hiddenFromDashboard Boolean     @default(false)
  needsReanalysis     Boolean     @default(false)
  reanalysisReason    String?
  analysisRunning     Boolean     @default(false)
  analysisStartedAt   DateTime?
  targetPrice         Float?
  nextAnalysisDate    DateTime?
  watchlists          Watchlist[] @relation("StockWatchlists")

  @@unique([clerkUserId, ticker])
  @@index([clerkUserId])
}

// A stock only carries this once it's marked status "watchlist" — these
// are the user's own categories (e.g. "Biotech", "Dividend Growth") for
// organizing which companies they're considering, not the watchlist
// status itself. A stock can belong to several, or none yet ("Unsorted").
model Watchlist {
  id          String   @id @default(cuid())
  clerkUserId String
  name        String
  createdAt   DateTime @default(now())
  stocks      Stock[]  @relation("StockWatchlists")

  @@index([clerkUserId])
}

model Analysis {
  id             String   @id @default(cuid())
  clerkUserId    String
  ticker         String
  date           DateTime @default(now())
  qualityScore   Int
  valuationScore Int
  action         String
  fullText       String
  frameworkName  String   @default("Buffett")

  @@index([clerkUserId, ticker])
}

// A user's own analysis framework — freeform instructions substituted for
// the built-in Buffett persona/criteria when generating an analysis. The
// Buffett framework itself isn't a row here; it's the default when no
// AnalysisFramework is selected.
model AnalysisFramework {
  id           String   @id @default(cuid())
  clerkUserId  String
  name         String
  instructions String
  createdAt    DateTime @default(now())

  @@index([clerkUserId])
}

// Global (not per-user) cache of a ticker's company logo, sourced from the
// price API's own ticker-details endpoint (branding.icon_url) — the actual
// company logo, not a favicon guessed from a domain name. The image bytes
// themselves are cached here (not just the upstream URL), so a page with
// several stocks never re-fetches from that tightly rate-limited API (see
// lib/prices.ts) on every view — only once, ever, per ticker. logoUrl is
// kept for debugging; imageData null means the lookup ran and genuinely
// found nothing, so it isn't retried forever (a failed *lookup*, as
// opposed to a failed fetch, leaves no row at all — see lib/logos.ts).
model TickerLogo {
  ticker      String   @id
  logoUrl     String?
  imageData   Bytes?
  contentType String?
  updatedAt   DateTime @updatedAt
}

// One row per ticker a user has looked up in the ticker search box,
// whether or not they went on to add it — powers the "Recently Searched"
// tab. Re-searching an already-logged ticker bumps searchedAt instead of
// creating a duplicate row.
model SearchHistory {
  id          String   @id @default(cuid())
  clerkUserId String
  ticker      String
  name        String
  cik         String?
  searchedAt  DateTime @default(now())

  @@unique([clerkUserId, ticker])
  @@index([clerkUserId])
}
