generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Stock {
  id                  String      @id @default(cuid())
  clerkUserId         String
  ticker              String
  name                String
  status              String
  lastPrice           Float?
  createdAt           DateTime    @default(now())
  priceAsOf           DateTime?
  hiddenFromDashboard Boolean     @default(false)
  needsReanalysis     Boolean     @default(false)
  reanalysisReason    String?
  analysisRunning     Boolean     @default(false)
  analysisStartedAt   DateTime?
  targetPrice         Float?
  watchlists          Watchlist[] @relation("StockWatchlists")

  @@unique([clerkUserId, ticker])
  @@index([clerkUserId])
}

// A stock only carries this once it's marked status "watchlist" — these
// are the user's own categories (e.g. "Biotech", "Dividend Growth") for
// organizing which companies they're considering, not the watchlist
// status itself. A stock can belong to several, or none yet ("Unsorted").
model Watchlist {
  id          String   @id @default(cuid())
  clerkUserId String
  name        String
  createdAt   DateTime @default(now())
  stocks      Stock[]  @relation("StockWatchlists")

  @@index([clerkUserId])
}

model Analysis {
  id             String   @id @default(cuid())
  clerkUserId    String
  ticker         String
  date           DateTime @default(now())
  qualityScore   Int
  valuationScore Int
  action         String
  fullText       String
  frameworkName  String   @default("Buffett")

  @@index([clerkUserId, ticker])
}

// A user's own analysis framework — freeform instructions substituted for
// the built-in Buffett persona/criteria when generating an analysis. The
// Buffett framework itself isn't a row here; it's the default when no
// AnalysisFramework is selected.
model AnalysisFramework {
  id           String   @id @default(cuid())
  clerkUserId  String
  name         String
  instructions String
  createdAt    DateTime @default(now())

  @@index([clerkUserId])
}

// Global (not per-user) cache of a ticker's homepage domain, used to build
// a favicon-based company logo. A company's domain never changes day to
// day, so each ticker is resolved against the price API's ticker-details
// endpoint at most once ever — that API's free tier is tightly rate
// limited (see lib/prices.ts), so this cache is load-bearing, not just an
// optimization. domain is null when the lookup ran but found nothing (a
// ticker with no homepage_url), so it isn't retried forever.
model TickerDomain {
  ticker    String   @id
  domain    String?
  updatedAt DateTime @updatedAt
}

// One row per ticker a user has looked up in the ticker search box,
// whether or not they went on to add it — powers the "Recently Searched"
// tab. Re-searching an already-logged ticker bumps searchedAt instead of
// creating a duplicate row.
model SearchHistory {
  id          String   @id @default(cuid())
  clerkUserId String
  ticker      String
  name        String
  searchedAt  DateTime @default(now())

  @@unique([clerkUserId, ticker])
  @@index([clerkUserId])
}
