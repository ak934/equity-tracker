generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Stock {
  id                  String    @id @default(cuid())
  ticker              String    @unique
  name                String
  status              String
  lastPrice           Float?
  createdAt           DateTime  @default(now())
  priceAsOf           DateTime?
  hiddenFromDashboard Boolean   @default(false)
  needsReanalysis     Boolean   @default(false)
  reanalysisReason    String?
  analysisRunning     Boolean   @default(false)
  analysisStartedAt   DateTime?
  targetPrice         Float?
}

model Analysis {
  id             String   @id @default(cuid())
  ticker         String
  date           DateTime @default(now())
  qualityScore   Int
  valuationScore Int
  action         String
  fullText       String

  @@index([ticker])
}
